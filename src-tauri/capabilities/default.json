{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "stronghold:default",
    "store:default",
    "dialog:default",
    "dialog:allow-open"
  ]
}